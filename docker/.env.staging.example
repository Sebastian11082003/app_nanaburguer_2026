# RestoOS / NanaBurguer — staging environment template
# Copy to docker/.env.staging and fill real values. Never commit secrets.

# Postgres
POSTGRES_USER=nanaburguer
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=nanaburguer_staging

# API
NODE_ENV=production
API_PORT=3000
JWT_SECRET=change-me-long-random-jwt-secret
DATABASE_URL=postgresql://nanaburguer:change-me-strong-password@db:5432/nanaburguer_staging?schema=public

# Frontend (baked at build time for Next.js)
FRONTEND_PORT=3001
# Public URL browsers use to reach the API (host IP/domain + API port)
NEXT_PUBLIC_API_URL=http://localhost:3000
# Comma-separated origins allowed by API CORS
CORS_ORIGIN=http://localhost:3001
