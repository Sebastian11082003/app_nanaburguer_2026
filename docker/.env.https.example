# VPS + HTTPS. Copy over docker/.env (or use --env-file).
# Point DNS A/AAAA of both hosts to the VPS before `up`.
# Rebuild frontend after changing NEXT_PUBLIC_API_URL.
#
# Do not leave the JWT or PLATFORM_ADMIN_PASSWORD values below as-is:
# the API refuses documented examples unless ALLOW_INSECURE_DEFAULTS=true.

POSTGRES_PASSWORD=replace-with-db-password
JWT_SECRET=replace-with-long-random-secret
FRONTEND_HOST=app.example.com
API_HOST=api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com
ALLOW_INSECURE_DEFAULTS=false
SEED_ON_BOOT=true
PLATFORM_ADMIN_EMAIL=you@example.com
PLATFORM_ADMIN_PASSWORD=replace-with-admin-password
