# VPS + HTTPS. Copy over docker/.env (or use --env-file).
# Point DNS A/AAAA of both hosts to the VPS before `up`.
# Rebuild frontend after changing NEXT_PUBLIC_API_URL.

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-at-least-16-chars
FRONTEND_HOST=app.example.com
API_HOST=api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com
