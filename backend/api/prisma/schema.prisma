generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////
// ENUMS
//////////////////////

enum UserRole {
  ADMIN
  CASHIER
  WAITER
  KITCHEN
}

enum OrderType {
  DINE_IN
  DELIVERY
  PICKUP
}

enum OrderStatus {
  CREATED
  SENT_TO_KITCHEN
  IN_PREPARATION
  READY
  DELIVERED
  CLOSED
  CANCELED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum InvoiceStatus {
  PENDING
  ACCEPTED
  REJECTED
}

//////////////////////
// TENANT
//////////////////////

model Restaurant {
  id        String   @id @default(uuid())
  name      String
  nit       String
  email     String?
  phone     String?

  factusApiKey String? @map("factus_api_key")
  isActive Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  users     User[]
  categories Category[]
  menuItems MenuItem[]
  tables    TableEntity[]
  orders    Order[]
  sales     Sale[]
  invoices  Invoice[]
  payments  Payment[]

  @@map("restaurant")
}

//////////////////////
// USERS
//////////////////////

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  fullName     String   @map("full_name")
  passwordHash String   @map("password_hash")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")

  restaurantId String   @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdOrders Order[] @relation("orders_created")
  updatedOrders Order[] @relation("orders_updated")
  statusChanges OrderStatusHistory[]

  payments Payment[]

  @@index([restaurantId])
  @@map("user")
}

//////////////////////
// MENU
//////////////////////

model Category {
  id           String  @id @default(uuid())
  name         String
  isActive     Boolean @default(true) @map("is_active")

  restaurantId String  @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items MenuItem[]

  @@index([restaurantId])
  @@map("category")
}

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  priceCents  Int      @map("price_cents")
  isAvailable Boolean  @default(true) @map("is_available")

  categoryId  String   @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id])

  restaurantId String  @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_item")
}

//////////////////////
// TABLES
//////////////////////

model TableEntity {
  id           String  @id @default(uuid())
  label        String
  capacity     Int
  isActive     Boolean @default(true) @map("is_active")

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  orders Order[]

  @@index([restaurantId])
  @@map("table_entity")
}

//////////////////////
// ORDER (OPERACIÓN)
//////////////////////

model Order {
  id     String     @id @default(uuid())
  type   OrderType
  status OrderStatus

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  tableId String?
  table   TableEntity? @relation(fields: [tableId], references: [id])

  customerName    String?
  customerPhone   String?
  deliveryAddress String?

  subtotalCents Int
  taxCents      Int
  totalCents    Int

  createdById String
  updatedById String

  createdBy User @relation("orders_created", fields: [createdById], references: [id])
  updatedBy User @relation("orders_updated", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  closedAt  DateTime?

  items   OrderItem[]
  history OrderStatusHistory[]
  sale    Sale?

  @@index([restaurantId])
  @@index([tableId])
  @@map("order_entity")
}

model OrderItem {
  id             String @id @default(uuid())
  orderId        String
  menuItemId     String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  notes          String?

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@map("order_item")
}

model OrderStatusHistory {
  id           String @id @default(uuid())
  orderId      String
  fromStatus   OrderStatus
  toStatus     OrderStatus
  changedById  String
  changedAt    DateTime @default(now())

  order     Order @relation(fields: [orderId], references: [id])
  changedBy User  @relation(fields: [changedById], references: [id])

  @@index([orderId])
  @@map("order_status_history")
}

//////////////////////
// SALE (DINERO)
//////////////////////

model Sale {
  id           String @id @default(uuid())
  orderId      String @unique
  restaurantId String

  totalCents Int

  order      Order      @relation(fields: [orderId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  payment Payment?
  invoice Invoice?

  createdAt DateTime @default(now())

  @@index([restaurantId])
  @@map("sale")
}

model Payment {
  id           String @id @default(uuid())
  saleId       String @unique
  restaurantId String

  method       PaymentMethod
  amountCents  Int
  currency     String @default("COP")

  createdById String
  createdBy   User @relation(fields: [createdById], references: [id])

  sale       Sale       @relation(fields: [saleId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  invoice Invoice?

  paidAt DateTime @default(now())

  @@index([restaurantId])
  @@map("payment")
}

//////////////////////
// FACTUS (INVOICE)
//////////////////////

model Invoice {
  id           String @id @default(uuid())
  saleId       String @unique
  paymentId    String @unique
  restaurantId String

  number String @unique
  cufe   String?
  status InvoiceStatus

  totalCents Int
  currency   String

  responseJson Json?

  sale       Sale       @relation(fields: [saleId], references: [id])
  payment    Payment    @relation(fields: [paymentId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  createdAt DateTime @default(now())

  @@index([restaurantId])
  @@map("invoice")
}